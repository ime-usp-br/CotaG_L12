# =============================================================================
# CotaG - Contrato unico de variaveis (Portainer / Docker Compose)
# =============================================================================
# Copie este conteudo para o campo de variaveis da stack no Portainer.
# Nomes iguais em dev, homologacao e producao; apenas os valores mudam.
#
# NAO versione .env, .env.dev, .env.homolog ou .env.prod.
# NAO suba .env no servidor: use as variaveis da stack no Portainer.
# Segredos (APP_KEY, DB_PASSWORD, SENHAUNICA_*, REPLICADO_PASSWORD) ficam
# apenas no Portainer/ambiente e nunca neste arquivo.
#
# APP_ENV=dev|homolog|prod. O mapeamento para o valor nativo do Laravel
# (local|production) esta em config/app.php e documentado em docs/deploy/README.md.
# =============================================================================

# -----------------------------------------------------------------------------
# Aplicacao
# -----------------------------------------------------------------------------
APP_NAME=CotaG
APP_ENV=dev
APP_DEBUG=true
APP_KEY=
APP_URL=https://dev.example.org
APP_VERSION=latest
APP_PREVIOUS_KEYS=
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
TZ=America/Sao_Paulo
WEB_PORT=8080

# Opcional: forca o valor nativo do Laravel se o mapeamento automatico
# nao for desejado. Deixe vazio para usar o mapeamento de APP_ENV.
# APP_ENV_NATIVE=

# -----------------------------------------------------------------------------
# Logs (stdout/stderr)
# -----------------------------------------------------------------------------
LOG_CHANNEL=stderr
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Banco externo por dominio (obrigatorio)
# -----------------------------------------------------------------------------
# DB_HOST e um DOMINIO DNS do banco do ambiente, nunca db/mysql/postgres/
# mariadb/localhost ou nome de servico Compose. O banco nao pertence a stack.
# dev:     db-dev.<dominio>
# homolog: db-homolog.<dominio>
# prod:    db.<dominio>
DB_CONNECTION=mysql
DB_HOST=db-dev.example.org
DB_PORT=3306
DB_DATABASE=cotag
DB_USERNAME=cotag_user
DB_PASSWORD=

# Opcional: URL unica. DB_URL e lida pelo Laravel; DATABASE_URL e aceita
# pelos scripts de backup/restore. Se usar URL, os DB_* acima podem ser
# omitidos apenas em execucao fora do Compose; no Portainer prefira DB_*.
DB_URL=
DATABASE_URL=

# -----------------------------------------------------------------------------
# Sessao, cache e filas
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# -----------------------------------------------------------------------------
# Redis (opcional; use apenas se CACHE_STORE/QUEUE_CONNECTION apontarem)
# -----------------------------------------------------------------------------
REDIS_URL=
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Mail
# -----------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@example.org
MAIL_FROM_NAME=CotaG

# -----------------------------------------------------------------------------
# AWS / S3 (opcional; so se FILESYSTEM_DISK=s3)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# -----------------------------------------------------------------------------
# USP - Senha Unica (OAuth)
# -----------------------------------------------------------------------------
SENHAUNICA_KEY=
SENHAUNICA_SECRET=
SENHAUNICA_CALLBACK_ID=

# -----------------------------------------------------------------------------
# USP - Replicado (SQL Server / FreeTDS)
# -----------------------------------------------------------------------------
# Preencha com os dados fornecidos pela infraestrutura. Nunca versione
# host, usuario ou senha reais.
REPLICADO_HOST=
REPLICADO_PORT=1433
REPLICADO_DATABASE=replicado
REPLICADO_USERNAME=
REPLICADO_PASSWORD=
REPLICADO_CODUNDCLG=
REPLICADO_SYBASE=true
REPLICADO_PATHLOG=/tmp/replicado.log
REPLICADO_USAR_CACHE=false
REPLICADO_DEBUG=false
REPLICADO_DEBUG_LEVEL=0

# -----------------------------------------------------------------------------
# Entrypoint
# -----------------------------------------------------------------------------
# dev:     RUN_MIGRATIONS=true, RUN_SEEDERS=true,  WARM_CACHE=false
# homolog: RUN_MIGRATIONS=true, RUN_SEEDERS=false, WARM_CACHE=true
# prod:    RUN_MIGRATIONS=true, RUN_SEEDERS=false, WARM_CACHE=true
RUN_MIGRATIONS=true
RUN_SEEDERS=true
WARM_CACHE=false
# CONTAINER_ROLE e definido pelo compose (app/worker); nao configure no Portainer.
# CONTAINER_ROLE=app

# -----------------------------------------------------------------------------
# Backup/restore do projeto (complementa o backup central da infra)
# -----------------------------------------------------------------------------
PROJECT_NAME=cotag
# No host/local: backups
# Dentro do container/Portainer: /var/www/html/storage/backups
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=7

# -----------------------------------------------------------------------------
# Build (UID/GID usados na imagem; nao sao segredos)
# -----------------------------------------------------------------------------
WWWUSER=1000
WWWGROUP=1000
