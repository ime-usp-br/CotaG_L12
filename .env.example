APP_NAME=CotaG
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Docker / Sail
APP_PORT=8000
WWWGROUP=1000
WWWUSER=1000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Banco de dados local (Sail)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=cotag
DB_USERNAME=sail
DB_PASSWORD=password

FORWARD_DB_PORT=3310

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# =============================================================================
# USP - Senha Única (OAuth)
# =============================================================================
SENHAUNICA_KEY=
SENHAUNICA_SECRET=
SENHAUNICA_CALLBACK_ID=

# =============================================================================
# USP - Replicado (SQL Server / FreeTDS)
# =============================================================================
# Preencha com os dados do Replicado fornecidos pela infraestrutura.
# Nunca versione host, usuário ou senha reais.
REPLICADO_HOST=
REPLICADO_PORT=1433
REPLICADO_DATABASE=replicado
REPLICADO_USERNAME=
REPLICADO_PASSWORD=
REPLICADO_CODUNDCLG=
REPLICADO_SYBASE=true
REPLICADO_PATHLOG=/tmp/replicado.log
REPLICADO_USAR_CACHE=false
REPLICADO_DEBUG=false
REPLICADO_DEBUG_LEVEL=0

# =============================================================================
# Produção / Portainer (docker-compose.prod.yml)
# =============================================================================
# Estes valores NÃO devem ser versionados com segredos reais. Configure-os
# na seção "Environment variables" do Stack no Portainer.
#
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://SEU_DOMINIO
# APP_KEY=base64:...              # gere com: php artisan key:generate --show
# APP_VERSION=1.0.0
#
# DB_CONNECTION=mysql
# DB_HOST=HOST_DO_BANCO
# DB_PORT=3306
# DB_DATABASE=cotag
# DB_USERNAME=cotag_user
# DB_PASSWORD=senha_forte
#
# LOG_STACK=daily
# LOG_LEVEL=warning
# RUN_MIGRATIONS=true
# RUN_SEEDERS=false
